# Copia este archivo a .env.local y rellena los valores. NUNCA subas .env.local al repositorio.

# --- Supabase (proyecto en la nube o local) ---------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
# Clave pública (anon / publishable). Solo la usará el panel de administración (fase 3).
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=replace-me
# Clave de servicio: SECRETA, solo servidor. Nunca con prefijo NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=replace-me

# --- Secretos de la aplicación (mínimo 32 caracteres cada uno) ----------------
# Genera cada uno con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
#
# SERVER_SECRET: de aquí se derivan (HKDF) las claves de los tokens QR, los tickets
# el hash de IP y los tokens de «Remember me». Rotarlo invalida los QR/tickets vigentes y hace que los dispositivos
# recordados dejen de reconocerse (los estudiantes solo tendrán que identificarse otra vez).
SERVER_SECRET=replace-me

# --- Ajustes de expiración (opcionales; valores por defecto abajo) ------------
# Gracia tras los 10 s de vida visible del QR. Rango 0–15000.
QR_GRACE_MS=5000
# Vida del ticket que se canjea al escanear. Rango 60–600.
TICKET_TTL_SECONDS=180
