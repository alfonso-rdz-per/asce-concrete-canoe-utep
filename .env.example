# Copy this file to .env.local and fill in the values. Never commit .env.local.

# --- Supabase ------------------------------------------------------------------
# Project URL (public).
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# Publishable (anon) key. Used only by the admin panel; the anon role has no table access.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=replace-me
# Service role key: SECRET, server only. Never give it a NEXT_PUBLIC_ prefix.
SUPABASE_SERVICE_ROLE_KEY=replace-me

# --- Application secret (at least 32 characters) --------------------------------
# Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
#
# All signing keys are derived from it with HKDF (QR tokens, check-in tickets, IP hashing and
# "Remember me" device tokens). Rotating it invalidates live QR codes/tickets and forgets
# remembered devices (students simply identify themselves again).
SERVER_SECRET=replace-me

# --- Optional expiry settings (defaults shown) ----------------------------------
# Grace period after the 10 s visible lifetime of each QR code. Range 0-15000.
QR_GRACE_MS=5000
# Lifetime of the ticket issued when a QR code is scanned. Range 60-600.
TICKET_TTL_SECONDS=180
